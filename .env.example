# Application
NODE_ENV=development
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/broadway_tracker

# Email / SMTP (required for verification and password-reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Broadway Tracker <hello@example.com>"

# Administrators. Comma or space separated. When set, this list is authoritative:
# a listed address is an administrator and an unlisted one is not, settled at
# sign-in. Leave it empty to manage roles in the database with pnpm db:grant-admin.
ADMIN_EMAILS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# RustFS / S3-compatible object storage (uploads are a future implementation slice)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=broadway
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Shared secret for the scheduled digest run. Without it, POST /api/digest
# refuses outright rather than being open by omission.
DIGEST_SECRET=

# The local language model, OpenAI-compatible. Nothing touching member data is
# ever sent anywhere else.
LM_STUDIO_ENDPOINT=
CHAT_MODEL_NAME=
# A self-hosted SearXNG, used to supplement Wikipedia when its engines answer.
SEAR_XNG_URL=
