# Application
NODE_ENV=development
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/broadway_tracker

# Email / SMTP (required for verification and password-reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Broadway Tracker <hello@example.com>"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# RustFS / S3-compatible object storage (uploads are a future implementation slice)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=broadway
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
